# Copy this file to .env and fill in your key.
# The dashboard (app.py / analyze.py) loads .env automatically.

# Required for the AI parts (themes + executive summaries). Charts work without it.
ANTHROPIC_API_KEY=sk-ant-REPLACE_WITH_YOUR_KEY

# Optional: model per task. Theme extraction reads many reviews (token-heavy) so it
# defaults to cheap Haiku; summaries are tiny but quality-sensitive so they default
# to Sonnet. Override either, or set STEAM_REVIEW_MODEL to force one model for both.
STEAM_EXTRACT_MODEL=claude-haiku-4-5
STEAM_SUMMARY_MODEL=claude-sonnet-4-6

# Optional: only refresh a saved analysis once this many new reviews accumulate.
# STEAM_ANALYSIS_MIN_NEW=100

# Optional: below this many reviews in a window, the analysis is still generated but
# flagged as a small sample (caveat in the summary + a banner in the UI).
# STEAM_ANALYSIS_LOW_CONFIDENCE=100

# Optional: floors applied only to the primary views (all-time + current release).
# Below MIN_REVIEWS total, the view shows a "not enough reviews" note instead of
# generating; a sentiment side with fewer than MIN_BUCKET reviews is skipped. Past
# release windows ignore these floors (they always generate, just caveated).
# STEAM_ANALYSIS_MIN_REVIEWS=25
# STEAM_ANALYSIS_MIN_BUCKET=10

# Optional: the moving "Last 7 days" themes refresh on a time basis, not a count.
# STEAM_RECENT_REFRESH_HOURS=24

# Optional: a language earns its own AI analysis only with enough volume AND enough
# sentiment divergence from the blended average (otherwise it reuses all-languages).
# STEAM_LANG_MIN_VOLUME=500
# STEAM_LANG_MIN_DIVERGENCE=8
