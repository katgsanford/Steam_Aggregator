# Copy this file to .env and fill in your key.
# The dashboard (app.py / analyze.py) loads .env automatically.

# Required for the AI parts (themes + executive summaries). Charts work without it.
ANTHROPIC_API_KEY=sk-ant-REPLACE_WITH_YOUR_KEY

# Optional: where the data lives (config.py). Leave DATABASE_URL unset to use the local
# reviews.db from config.json, exactly as before. Set it to a Turso (libSQL) database to
# read and write the cloud copy instead; TURSO_AUTH_TOKEN is a database-scoped token
# (`turso db tokens create steam`), never an organization/platform token.
# DATABASE_URL=libsql://steam-<org>.turso.io
# TURSO_AUTH_TOKEN=

# Optional: pin a model per task. Leave these unset and models.py tracks the newest
# model in each family automatically (current Haiku for the token-heavy theme
# extraction passes, current Opus for the quality-sensitive summaries). Setting one
# freezes that task on the ID you give, so only set it to pin a model deliberately.
# STEAM_EXTRACT_MODEL=claude-haiku-5-5
# STEAM_SUMMARY_MODEL=claude-opus-5-5
# STEAM_NARRATIVE_MODEL=claude-opus-5-5   # the daily report's narrative
# STEAM_REVIEW_MODEL=            # legacy: pins every task to one model
# STEAM_MODEL_AUTO=0             # skip discovery; use the pinned fallbacks in models.py
# STEAM_MODEL_CACHE_HOURS=24     # how long a discovery result is reused

# Optional: thinking effort per task — low | medium | high | xhigh | max. Extraction
# defaults to low (it runs over every review batch, so effort costs real money there);
# summaries default to high (one short call per view, where quality is worth paying for);
# the daily narrative defaults to medium.
# An unrecognised value is ignored with a warning rather than failing the call.
# STEAM_EXTRACT_EFFORT=low
# STEAM_SUMMARY_EFFORT=high
# STEAM_NARRATIVE_EFFORT=medium

# Optional: only refresh a saved analysis once this many new reviews accumulate.
# STEAM_ANALYSIS_MIN_NEW=100

# Optional: below this many reviews in a window, the analysis is still generated but
# flagged as a small sample (caveat in the summary + a banner in the UI).
# STEAM_ANALYSIS_LOW_CONFIDENCE=100

# Optional: floors applied only to the primary views (all-time + current release).
# Below MIN_REVIEWS total, the view shows a "not enough reviews" note instead of
# generating; a sentiment side with fewer than MIN_BUCKET reviews is skipped. Past
# release windows ignore these floors (they always generate, just caveated).
# STEAM_ANALYSIS_MIN_REVIEWS=25
# STEAM_ANALYSIS_MIN_BUCKET=10

# Optional: the moving "Last 7 days" themes refresh on a time basis, not a count.
# STEAM_RECENT_REFRESH_HOURS=24

# Optional: a language earns its own AI analysis only with enough volume AND enough
# sentiment divergence from the blended average (otherwise it reuses all-languages).
# STEAM_LANG_MIN_VOLUME=500
# STEAM_LANG_MIN_DIVERGENCE=8
